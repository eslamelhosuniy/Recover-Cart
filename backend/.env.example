# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/recover_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Webhooks
ACCEPTED_EVENTS={"abandoned.cart.updated": "recover_salla", "abandoned.cart": "recover_salla"}

# App
APP_ENV=development
APP_SECRET_KEY=your_secret_key
REMINDER_DELAY_HOURS=1

# CORS — JSON array of allowed frontend origins
# Development: ["http://localhost:5173","http://localhost:3000"]
# Production:  ["https://yourdomain.com"]
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]